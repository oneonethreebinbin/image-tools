# Google AdSense publisher ID from the "Get code" button.
# Example: ca-pub-1234567890123456
VITE_ADSENSE_CLIENT=

# Optional manual ad unit slot IDs from AdSense.
# Leave these empty if you only want Auto ads.
VITE_ADSENSE_SLOT_BANNER=
VITE_ADSENSE_SLOT_SIDEBAR=
VITE_ADSENSE_SLOT_INLINE=
VITE_ADSENSE_SLOT_TOOL=
